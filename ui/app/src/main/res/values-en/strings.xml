    <string name="save_policy_title">Save the image that gets sent</string>
    <string name="save_policy_hint">Sensitive apps always ask, even if you pick «always».</string>
    <string name="save_policy_always">Always</string>
    <string name="save_policy_always_desc">The image is saved on the device.</string>
    <string name="save_policy_ask">Ask first</string>
    <string name="save_policy_ask_desc">You confirm whether to save it, capture by capture.</string>
    <string name="save_policy_never">Never</string>
    <string name="save_policy_never_desc">No image is saved on the device.</string>
    <string name="measure_app_control">Per-app control</string>
    <string name="measure_app_control_desc">Applies a sensitivity level to each app. If you turn it off, everything is treated as normal.</string>
    <string name="measure_drop_password">Ignore password fields</string>
    <string name="measure_drop_password_desc">Password fields on screen are never included.</string>
    <string name="measure_preview">Preview before sending</string>
    <string name="measure_preview_desc">For sensitive apps, shows exactly what will be sent and asks for confirmation.</string>
    <string name="measure_redact">Hide personal data</string>
    <string name="measure_redact_desc">Replaces cards, IBANs, emails, phone numbers and IDs with markers. It is a safety net: it does not catch everything.</string>
    <string name="measure_audit">Log of what was sent</string>
    <string name="measure_audit_desc">Keeps only metadata (time, app, tool and size) of what leaves the device.</string>
    <string name="measure_propose">Suggest by name</string>
    <string name="measure_propose_desc">Suggests protecting unknown apps whose name looks like banking or passwords.</string>

